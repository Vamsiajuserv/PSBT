# ── PSBT-Portal backend environment (template) ───────────────────────────────
# Copy to .env and fill in real values. Do NOT commit the real .env.
PGHOST=your-server.postgres.database.azure.com
PGUSER=your_db_user
PGPORT=5432
PGDATABASE=psbt_db
PGPASSWORD=your_password
PGSSLMODE=require

JWT_SECRET=change-me-generate-with-secrets.token_hex(32)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Cookie Settings (Phase 1 Security: FE-001 - XSS Protection)
# Set JWT_COOKIE_SECURE=false only for local dev without HTTPS
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax

# Encryption Keys (Phase 1 Security: PRIV-001, INF-001)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED for production - protects PAN numbers and backup data
PAN_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

APP_NAME=PSBT-Portal API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Payments — blank = sandbox provider (auto-success). Fill for live Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Translation — blank = verified offline glossary. Add Azure AI Translator key for dynamic.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Prokerala Official API — Telugu Panchang data (https://api.prokerala.com)
# Get your credentials at: https://api.prokerala.com/dashboard
# Free tier: 5,000 credits/month, 5 requests/minute
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Email Notifications (SMTP) — blank = emails logged but not sent
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Temple Name <your-email@gmail.com>
